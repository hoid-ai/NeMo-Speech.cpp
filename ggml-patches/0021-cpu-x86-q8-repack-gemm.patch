@@ -15,6 +15,17 @@
 #include <cstdlib> // for qsort
 #include <cstdio>  // for GGML_ASSERT
 
+// Runtime AVX-VNNI detection for the Q8_0 repack GEMM (see the bottom of
+// this file): the backend is built for plain AVX2, so VPDPBUSD is selected
+// per CPU rather than per build.
+#if defined(__x86_64__) || defined(__i386__)
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(__GNUC__) || defined(__clang__)
+#include <cpuid.h>
+#endif
+#endif
+
 #define GGML_CPU_CLANG_WORKAROUND
 #include "../../repack.h"
 
@@ -6405,3 +6416,241 @@ void ggml_gemm_q2_K_8x8_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
 
 #endif
 }
+
+// =====================================================================
+// Q8_0 x Q8_0, eight weight columns interleaved at 4-byte granularity.
+//
+// Upstream ggml repacks Q8_0 only for NEON and RISC-V. On x86 a Q8_0
+// weight matrix therefore went through the generic mul_mat path, which
+// calls ggml_vec_dot_q8_0_q8_0 once per output element: no register
+// blocking, and the activation column is re-read from memory for every
+// weight row.
+//
+// The q8_0_8x4 layout puts eight columns of one Q8_0 block in each
+// 32-byte group, four bytes per column, so a single vector load covers
+// all eight columns and _mm256_madd_epi16 reduces exactly four bytes
+// into each of the eight int32 lanes - one lane per column, no
+// horizontal shuffle in the inner loop. Four activation rows are held in
+// registers per pass, so each weight load feeds four rows.
+//
+// Signedness: maddubs and VPDPBUSD both want an unsigned left operand.
+// Fold the weight's sign into the activation and use |w|, which is the
+// same trick ggml's scalar Q8_0 dot product uses. Q8_0 quantizes with
+// d = amax/127, so |w| <= 127 and |a| <= 127: each maddubs pair sums to
+// at most 2*127*127 = 32258 and cannot saturate int16.
+// =====================================================================
+
+#if defined(__AVX2__)
+
+// True when the running CPU implements AVX-VNNI (CPUID.(EAX=7,ECX=1):EAX[4]).
+// The build targets plain AVX2 - GGML_NATIVE is off so the binary must run on
+// any AVX2 x86 - so VPDPBUSD is reached through a target-attributed function
+// selected here at run time, never by compiling the whole backend for it.
+static bool ggml_x86_has_avx_vnni(void) {
+#if defined(__AVXVNNI__)
+    return true;  // Compiled for it outright (e.g. a -march=native build).
+#elif defined(_MSC_VER)
+    int regs[4];
+    __cpuidex(regs, 7, 1);
+    return (regs[0] & (1 << 4)) != 0;
+#elif defined(__GNUC__) || defined(__clang__)
+    unsigned eax = 0, ebx = 0, ecx = 0, edx = 0;
+    if (!__get_cpuid_count(7, 1, &eax, &ebx, &ecx, &edx)) {
+        return false;
+    }
+    return (eax & (1u << 4)) != 0;
+#else
+    return false;
+#endif
+}
+
+// A target attribute is how a VPDPBUSD kernel gets compiled inside an
+// AVX2-only translation unit. MSVC has no equivalent but emits every
+// intrinsic regardless of switches, so it compiles the kernel directly;
+// anything else stays on the AVX2 path.
+#if defined(__AVXVNNI__)
+#define GGML_Q8_VNNI_TARGET
+#define GGML_Q8_HAS_VNNI_KERNEL 1
+#elif defined(__GNUC__) || defined(__clang__)
+#define GGML_Q8_VNNI_TARGET __attribute__((target("avx2,avxvnni")))
+#define GGML_Q8_HAS_VNNI_KERNEL 1
+#elif defined(_MSC_VER)
+#define GGML_Q8_VNNI_TARGET
+#define GGML_Q8_HAS_VNNI_KERNEL 1
+#else
+#define GGML_Q8_HAS_VNNI_KERNEL 0
+#endif
+
+// One 32-byte weight group (8 columns x 4 bytes) against four activation
+// rows, accumulating int32 per column. Written once and instantiated twice
+// through DOT so the AVX2 and VNNI kernels cannot drift apart.
+#define GGML_Q8_8X4_BLOCK_BODY(DOT)                                                        \
+    do {                                                                                   \
+        for (int k = 0; k < QK8_0 / 4; k++) {                                              \
+            const __m256i bv    = _mm256_loadu_si256((const __m256i *) (b_ptr[l].qs + k * 32)); \
+            const __m256i b_abs = _mm256_sign_epi8(bv, bv);                                \
+            for (int m = 0; m < 4; m++) {                                                  \
+                int32_t a4;                                                                \
+                memcpy(&a4, a_qs + k * 16 + m * 4, sizeof(a4));                            \
+                const __m256i av = _mm256_sign_epi8(_mm256_set1_epi32(a4), bv);            \
+                iacc[m]          = DOT(iacc[m], b_abs, av);                                \
+            }                                                                              \
+        }                                                                                  \
+    } while (0)
+
+#define GGML_Q8_DOT_AVX2(acc, u, v) \
+    _mm256_add_epi32((acc), _mm256_madd_epi16(_mm256_maddubs_epi16((u), (v)), _mm256_set1_epi16(1)))
+
+#if GGML_Q8_HAS_VNNI_KERNEL
+#define GGML_Q8_DOT_VNNI(acc, u, v) _mm256_dpbusd_avx_epi32((acc), (u), (v))
+#endif
+
+// Scale one block's int32 column sums by d_weight[0..7] * d_activation[m]
+// and fold them into the running float accumulators.
+static inline void ggml_q8_8x4_scale_block(const block_q8_0x8 * GGML_RESTRICT b,
+                                           const ggml_half * GGML_RESTRICT    a_d,
+                                           const __m256i *                    iacc,
+                                           __m256 *                           facc,
+                                           int                                nrows) {
+    const __m256 db = GGML_F32Cx8_LOAD(b->d);
+    for (int m = 0; m < nrows; m++) {
+        const __m256 da = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a_d[m]));
+        facc[m] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc[m]), _mm256_mul_ps(db, da), facc[m]);
+    }
+}
+
+#define GGML_Q8_8X4_GEMM_BODY(DOT)                                                      \
+    do {                                                                                \
+        const int nb = n / QK8_0;                                                       \
+        for (int y = 0; y < nr / 4; y++) {                                              \
+            const block_q8_0x4 * a_ptr = (const block_q8_0x4 *) vy + (y * nb);          \
+            for (int x = 0; x < nc / 8; x++) {                                          \
+                const block_q8_0x8 * b_ptr = (const block_q8_0x8 *) vx + (x * nb);      \
+                __m256 facc[4] = { _mm256_setzero_ps(), _mm256_setzero_ps(),            \
+                                   _mm256_setzero_ps(), _mm256_setzero_ps() };          \
+                for (int l = 0; l < nb; l++) {                                          \
+                    const int8_t * a_qs = a_ptr[l].qs;                                  \
+                    __m256i iacc[4] = { _mm256_setzero_si256(), _mm256_setzero_si256(), \
+                                        _mm256_setzero_si256(), _mm256_setzero_si256() }; \
+                    GGML_Q8_8X4_BLOCK_BODY(DOT);                                        \
+                    ggml_q8_8x4_scale_block(&b_ptr[l], a_ptr[l].d, iacc, facc, 4);      \
+                }                                                                       \
+                for (int m = 0; m < 4; m++) {                                           \
+                    _mm256_storeu_ps(s + (y * 4 + m) * bs + x * 8, facc[m]);            \
+                }                                                                       \
+            }                                                                           \
+        }                                                                               \
+    } while (0)
+
+// gemv: one activation row, quantized as plain (non-interleaved) block_q8_0.
+// Its 32 bytes are contiguous, so the same 4-byte broadcast works with a
+// stride of 4 instead of 16.
+#define GGML_Q8_8X4_GEMV_BODY(DOT)                                                          \
+    do {                                                                                    \
+        const int          nb    = n / QK8_0;                                               \
+        const block_q8_0 * a_ptr = (const block_q8_0 *) vy;                                 \
+        for (int x = 0; x < nc / 8; x++) {                                                  \
+            const block_q8_0x8 * b_ptr = (const block_q8_0x8 *) vx + (x * nb);              \
+            __m256               facc  = _mm256_setzero_ps();                               \
+            for (int l = 0; l < nb; l++) {                                                  \
+                __m256i iacc = _mm256_setzero_si256();                                      \
+                for (int k = 0; k < QK8_0 / 4; k++) {                                       \
+                    const __m256i bv =                                                      \
+                        _mm256_loadu_si256((const __m256i *) (b_ptr[l].qs + k * 32));       \
+                    const __m256i b_abs = _mm256_sign_epi8(bv, bv);                         \
+                    int32_t       a4;                                                       \
+                    memcpy(&a4, a_ptr[l].qs + k * 4, sizeof(a4));                           \
+                    const __m256i av = _mm256_sign_epi8(_mm256_set1_epi32(a4), bv);         \
+                    iacc             = DOT(iacc, b_abs, av);                                \
+                }                                                                           \
+                const __m256 db = GGML_F32Cx8_LOAD(b_ptr[l].d);                             \
+                const __m256 da = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a_ptr[l].d));        \
+                facc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc), _mm256_mul_ps(db, da), facc); \
+            }                                                                               \
+            _mm256_storeu_ps(s + x * 8, facc);                                              \
+        }                                                                                   \
+    } while (0)
+
+static void ggml_gemm_q8_0_8x4_q8_0_avx2(int n, float * GGML_RESTRICT s, size_t bs,
+                                         const void * GGML_RESTRICT vx,
+                                         const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_Q8_8X4_GEMM_BODY(GGML_Q8_DOT_AVX2);
+}
+
+static void ggml_gemv_q8_0_8x4_q8_0_avx2(int n, float * GGML_RESTRICT s, size_t bs,
+                                         const void * GGML_RESTRICT vx,
+                                         const void * GGML_RESTRICT vy, int nr, int nc) {
+    UNUSED(bs);
+    UNUSED(nr);
+    GGML_Q8_8X4_GEMV_BODY(GGML_Q8_DOT_AVX2);
+}
+
+#if GGML_Q8_HAS_VNNI_KERNEL
+GGML_Q8_VNNI_TARGET
+static void ggml_gemm_q8_0_8x4_q8_0_vnni(int n, float * GGML_RESTRICT s, size_t bs,
+                                         const void * GGML_RESTRICT vx,
+                                         const void * GGML_RESTRICT vy, int nr, int nc) {
+    GGML_Q8_8X4_GEMM_BODY(GGML_Q8_DOT_VNNI);
+}
+
+GGML_Q8_VNNI_TARGET
+static void ggml_gemv_q8_0_8x4_q8_0_vnni(int n, float * GGML_RESTRICT s, size_t bs,
+                                         const void * GGML_RESTRICT vx,
+                                         const void * GGML_RESTRICT vy, int nr, int nc) {
+    UNUSED(bs);
+    UNUSED(nr);
+    GGML_Q8_8X4_GEMV_BODY(GGML_Q8_DOT_VNNI);
+}
+#endif  // GGML_Q8_HAS_VNNI_KERNEL
+
+#endif  // __AVX2__
+
+void ggml_gemm_q8_0_8x4_q8_0(int                        n,
+                             float * GGML_RESTRICT      s,
+                             size_t                     bs,
+                             const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy,
+                             int                        nr,
+                             int                        nc) {
+#if defined(__AVX2__)
+    assert(n % QK8_0 == 0);
+    assert(nr % 4 == 0);
