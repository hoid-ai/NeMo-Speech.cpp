+// A depthwise kernel is one tiny per-channel window. Stage it as F32 once per
+// channel so the loops below are type-agnostic, which is also what lets this
+// operator accept F16 weights on the CPU at all: it previously cast
+// kernel->data straight to float, so an F16 kernel was read as garbage.
+static void ggml_conv_2d_dw_kernel_f32(
+        const ggml_tensor * kernel, int64_t channel, int64_t knl_n, float * GGML_RESTRICT out) {
+    if (kernel->type == GGML_TYPE_F16) {
+        ggml_fp16_to_fp32_row((const ggml_fp16_t *)kernel->data + channel*knl_n, out, knl_n);
+    } else {
+        memcpy(out, (const float *)kernel->data + channel*knl_n, knl_n*sizeof(float));
+    }
+}
